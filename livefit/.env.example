# ===== LiveFit Spring Boot 後端環境變數 =====
# 由 application.properties 的 spring.config.import 讀入（Spring Boot 原生支援，不需額外套件）
# 格式是 Java properties：KEY=value，不要加引號、不要寫 export
#
# 這是範本檔。複製成 .env 後填入實際值。
#   cp .env.example .env

# 應用程式連接埠
PORT=8080

# PostgreSQL（容器化後 DB_HOST 要改成 postgres）
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=student
DB_PASSWORD=student666
DB_DATABASE=livefit

# JWT：必填，沒有預設值；留空或少於 32 個位元組（HS256 規格要求）都會讓啟動直接失敗
# 產生方式（擇一，把輸出的那一行貼在等號後面，不要加引號）：
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 完整說明見 docs/springboot-migration-plan.md §2「產生 JWT_SECRET」
JWT_SECRET=
JWT_EXPIRES_DAY=30d

# Hibernate schema 策略：update 會依 Entity 自動建表 / 補欄位；不想讓它動 schema 時改成 none
DDL_AUTO=update

# Google 登入：OAuth 2.0 Client ID（Web application），需與 frontend/.env 的 VITE_GOOGLE_CLIENT_ID 相同
GOOGLE_CLIENT_ID=

# GitHub 登入：OAuth App 的 Client ID 與 Client secret
# Client ID 需與 frontend/.env 的 VITE_GITHUB_CLIENT_ID 相同；secret 只放這裡，不要放到前端
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook 登入：Meta for Developers 應用程式的編號與密鑰
# 編號需與 frontend/.env 的 VITE_FACEBOOK_APP_ID 相同；密鑰只放這裡，不要放到前端
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# 第三方登入允許的 redirect_uri（逗號分隔），必須與各平台後台登記的 callback URL 完全相同
OAUTH_REDIRECT_URIS=http://localhost:5173/oauth/callback/github,http://localhost:3000/oauth/callback/github,http://localhost:5173/oauth/callback/facebook,http://localhost:3000/oauth/callback/facebook
