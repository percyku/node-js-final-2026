{
  "name": "fitness-backend-final",
  "version": "1.0.0",
  "private": true,
  "description": "健身房後端 API — 最終作業驗收包。前端、Swagger、測試都在這裡。",
  "scripts": {
    "start": "node .github/scripts/check-backend.js && npm --prefix backend start",
    "test": "jest --runInBand",
    "test:m1": "jest test/m1.test.js --runInBand",
    "test:m2": "jest test/m2.test.js --runInBand",
    "test:m3": "jest test/m3.test.js --runInBand",
    "test:m4": "jest test/m4.test.js --runInBand",
    "test:m5": "jest test/m5.test.js --runInBand",
    "test:m6": "jest test/m6.test.js --runInBand",
    "test:smoke": "jest test/smoke.test.js --runInBand",
    "db:reset": "docker compose down -v && docker compose up -d",
    "postman:build": "node postman/build-collection.js",
    "postman:test": "newman run postman/livefit.postman_collection.json"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "modulePathIgnorePatterns": [
      "<rootDir>/backend/"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "newman": "6.2.3",
    "supertest": "^7.0.0"
  }
}
