VITE_API_BASE_URL=http://127.0.0.1:8080/api/
# Google 登入用的 OAuth 2.0 Client ID（Web application），需與 livefit/.env 的 GOOGLE_CLIENT_ID 相同
# 留空時登入 / 註冊頁不會顯示 Google 登入按鈕
VITE_GOOGLE_CLIENT_ID=
# GitHub 登入用的 OAuth App Client ID，需與 livefit/.env 的 GITHUB_CLIENT_ID 相同
# （Client secret 只放後端，不要放在這裡）；留空時不會顯示 GitHub 登入按鈕
VITE_GITHUB_CLIENT_ID=
# Facebook 登入用的應用程式編號，需與 livefit/.env 的 FACEBOOK_APP_ID 相同
# （應用程式密鑰只放後端，不要放在這裡）；留空時不會顯示 Facebook 登入按鈕
VITE_FACEBOOK_APP_ID=
